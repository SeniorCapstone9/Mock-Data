lerna-debug.log*

# ---- Python (server) ----
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv
venv/
env/
.conda/
**/.venv

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/

# ---- App runtime artifacts ----
**/temp/
*.db
*.sqlite
*.sqlite3
server/error_log.txt

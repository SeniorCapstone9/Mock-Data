# ---- Secrets / environment ----
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# ---- OS junk ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Node / Vite (client) ----
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
**/.cache/
**/.eslintcache
**/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
